# Supabase (Project Settings > API). The anon key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://nnmjdeesanryebfubckj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site (used for Square's return link)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Square (developer.squareup.com). Start with Sandbox.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Webhook subscription: the exact URL Square calls, and its signature key
SQUARE_WEBHOOK_URL=http://localhost:3000/api/webhooks/square
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Store settings (cents / percent). Placeholders: set your real values.
DELIVERY_FEE_CENTS=0
FREE_DELIVERY_MIN_CENTS=0
TAX_PERCENT=0
